        </mxCell>
        <mxCell id="a4" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#888888;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="668" as="sourcePoint" /><mxPoint x="470" y="664" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a5" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#888888;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="798" as="sourcePoint" /><mxPoint x="470" y="798" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ===== Lane 3: Outcomes (right) ===== -->
        <mxCell id="outTitle" value="Effect" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
          <mxGeometry x="980" y="124" width="340" height="30" as="geometry" />
        </mxCell>

        <mxCell id="o1" value="exit 0 → stdout injected into context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E7E34;fontSize=13;fontColor=#14532D;align=center;" vertex="1" parent="1">
          <mxGeometry x="980" y="170" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="exit 0 → context + logs/prompts.log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E7E34;fontSize=13;fontColor=#14532D;align=center;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="o3a" value="⚠ exit 2 → VETO the tool&#10;(stderr fed back to Claude)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#B00020;fontSize=13;fontColor=#7A0012;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="412" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o3b" value="exit 0 → logs/audit.jsonl (one line / call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E7E34;fontSize=13;fontColor=#14532D;align=center;" vertex="1" parent="1">
          <mxGeometry x="980" y="476" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="exit 0 → file reformatted in place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E7E34;fontSize=13;fontColor=#14532D;align=center;" vertex="1" parent="1">
          <mxGeometry x="980" y="640" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="exit 0 → notification + logs/session.log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E7E34;fontSize=13;fontColor=#14532D;align=center;" vertex="1" parent="1">
          <mxGeometry x="980" y="772" width="340" height="46" as="geometry" />
