        </mxCell>

        <!-- ===== Bottom: test harness + logs ===== -->
        <mxCell id="testBox" value="🧪  ./test-hooks.sh  —  pipes a sample JSON event into each script and asserts the exit code, so you can validate every hook WITHOUT launching Claude Code  (7 passed, 0 failed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
